23'        / string version of target id                    KEPLERID=              7907423 / unique Kepler target identifier                RADESYS = 'ICRS    '           / reference frame of celestial coordinates       RA_OBJ  =           296.985060 / [deg] right ascension                          DEC_OBJ =            43.658520 / [deg] declination                              EQUINOX =               2000.0 / equinox of celestial coordinate system         WCSAXES =                    2 / number of WCS axes                             CTYPE1  = 'RA---TAN'           / right ascension coordinate type                CTYPE2  = 'DEC--TAN'           / declination coordinate type                    CRPIX1  =    3.845267265411394 / [pixel] reference pixel along image axis 1     CRPIX2  =   3.1203639440254847 / [pixel] reference pixel along image axis 2     CRVAL1  =   296.98506000000003 / [deg] right ascension at reference pixel       CRVAL2  =             43.65852 / [deg] declination at reference pixel           CUNIT1  = 'deg     '           / physical unit in column dimension              CUNIT2  = 'deg     '           / physical unit in row dimension                 CDELT1  =   -0.001108396268462 / [deg] pixel scale in RA dimension              CDELT2  =    0.001108396268462 / [deg] pixel scale in Dec dimension             PC1_1   =  0.48029794165171485 / linear transformation element cos(th)          PC1_2   =   0.8805585308499431 / linear transformation element -sin(th)         PC2_1   =   0.8753145587242039 / linear transformation element sin(th)          PC2_2   = -0.47727520411585833 / linear transformation element cos(th)          WCSNAMEP= 'PHYSICAL'           / name of world coordinate system alternate P    WCSAXESP=                    2 / number of WCS physical axes                    CTYPE1P = 'RAWX    '           / physical WCS axis 1 type CCD col               CUNIT1P = 'PIXEL   '           / physical WCS axis 1 unit                       CRPIX1P =           