 1 / extension version number (not format version)  TELESCOP= 'Kepler  '           / telescope                                      INSTRUME= 'Kepler Photometer'  / detector type                                  OBJECT  = 'KIC 6362874'        / string version of target id                    KEPLERID=              6362874 / unique Kepler target identifier                RADESYS = 'ICRS    '           / reference frame of celestial coordinates       RA_OBJ  =           291.433290 / [deg] right ascension                          DEC_OBJ =            41.703440 / [deg] declination                              EQUINOX =               2000.0 / equinox of celestial coordinate system         WCSAXES =                    2 / number of WCS axes                             CTYPE1  = 'RA---TAN'           / right ascension coordinate type                CTYPE2  = 'DEC--TAN'           / declination coordinate type                    CRPIX1  =   3.9180363510575944 / [pixel] reference pixel along image axis 1     CRPIX2  =    2.946340818444696 / [pixel] reference pixel along image axis 2     CRVAL1  =            291.43329 / [deg] right ascension at reference pixel       CRVAL2  =             41.70344 / [deg] declination at reference pixel           CUNIT1  = 'deg     '           / physical unit in column dimension              CUNIT2  = 'deg     '           / physical unit in row dimension                 CDELT1  =   -0.001099774656071 / [deg] pixel scale in RA dimension              CDELT2  = 0.001099774656071493 / [deg] pixel scale in Dec dimension             PC1_1   =  -0.8397564075985132 / linear transformation element cos(th)          PC1_2   =  -0.5341400647733808 / linear transformation element -sin(th)         PC2_1   =   0.5389010592633361 / linear transformation element sin(th)          PC2_2   =  -0.8480451555412447 / linear transformation element cos(th)          WCSNAMEP= 'PHYSICAL'           / name of world coordinate system alternate P    WCSAXESP=                   