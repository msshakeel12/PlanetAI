  =                    1 / extension version number (not format version)  TELESCOP= 'Kepler  '           / telescope                                      INSTRUME= 'Kepler Photometer'  / detector type                                  OBJECT  = 'KIC 7938496'        / string version of target id                    KEPLERID=              7938496 / unique Kepler target identifier                RADESYS = 'ICRS    '           / reference frame of celestial coordinates       RA_OBJ  =           281.960621 / [deg] right ascension                          DEC_OBJ =            43.703110 / [deg] declination                              EQUINOX =               2000.0 / equinox of celestial coordinate system         WCSAXES =                    2 / number of WCS axes                             CTYPE1  = 'RA---TAN'           / right ascension coordinate type                CTYPE2  = 'DEC--TAN'           / declination coordinate type                    CRPIX1  =     3.18119111383794 / [pixel] reference pixel along image axis 1     CRPIX2  =   1.6715040873127691 / [pixel] reference pixel along image axis 2     CRVAL1  =          281.9606205 / [deg] right ascension at reference pixel       CRVAL2  =             43.70311 / [deg] declination at reference pixel           CUNIT1  = 'deg     '           / physical unit in column dimension              CUNIT2  = 'deg     '           / physical unit in row dimension                 CDELT1  =   -0.001099800892004 / [deg] pixel scale in RA dimension              CDELT2  =    0.001099800892004 / [deg] pixel scale in Dec dimension             PC1_1   =  -0.6260802065487115 / linear transformation element cos(th)          PC1_2   =   0.7734299003883821 / linear transformation element -sin(th)         PC2_1   =  -0.7810394644332826 / linear transformation element sin(th)          PC2_2   =  -0.6323801977489392 / linear transformation element cos(th)          WCSNAMEP= 'PHYSICAL'           / name of world coordinate system alternate P    WCSAXE