 1 / group count (not used)                         INHERIT =                    T / inherit the primary header                     EXTNAME = 'APERTURE'           / name of extension                              EXTVER  =                    1 / extension version number (not format version)  TELESCOP= 'Kepler  '           / telescope                                      INSTRUME= 'Kepler Photometer'  / detector type                                  OBJECT  = 'KIC 3839488'        / string version of target id                    KEPLERID=              3839488 / unique Kepler target identifier                RADESYS = 'ICRS    '           / reference frame of celestial coordinates       RA_OBJ  =           288.133710 / [deg] right ascension                          DEC_OBJ =            38.996880 / [deg] declination                              EQUINOX =               2000.0 / equinox of celestial coordinate system         WCSAXES =                    2 / number of WCS axes                             CTYPE1  = 'RA---TAN'           / right ascension coordinate type                CTYPE2  = 'DEC--TAN'           / declination coordinate type                    CRPIX1  =     4.46287859817113 / [pixel] reference pixel along image axis 1     CRPIX2  =   3.3771971108453727 / [pixel] reference pixel along image axis 2     CRVAL1  =            288.13371 / [deg] right ascension at reference pixel       CRVAL2  =             38.99688 / [deg] declination at reference pixel           CUNIT1  = 'deg     '           / physical unit in column dimension              CUNIT2  = 'deg     '           / physical unit in row dimension                 CDELT1  =   -0.001105841069523 / [deg] pixel scale in RA dimension              CDELT2  =    0.001105841069523 / [deg] pixel scale in Dec dimension             PC1_1   =    0.571292462607575 / linear transformation element cos(th)          PC1_2   =   0.8221433944299433 / linear transformation element -sin(th)         PC2_1   =   0.82041564259747