33 / [deg] declination at reference pixel           CUNIT1  = 'deg     '           / physical unit in column dimension              CUNIT2  = 'deg     '           / physical unit in row dimension                 CDELT1  =   -0.001104451758937 / [deg] pixel scale in RA dimension              CDELT2  =    0.001104451758937 / [deg] pixel scale in Dec dimension             PC1_1   =  -0.8664128705185805 / linear transformation element cos(th)          PC1_2   =  0.49906003512326497 / linear transformation element -sin(th)         PC2_1   =   0.4993231567372606 / linear transformation element sin(th)          PC2_2   =   0.8665704231880312 / linear transformation element cos(th)          WCSNAMEP= 'PHYSICAL'           / name of world coordinate system alternate P    WCSAXESP=                    2 / number of WCS physical axes                    CTYPE1P = 'RAWX    '           / physical WCS axis 1 type CCD col               CUNIT1P = 'PIXEL   '           / physical WCS axis 1 unit                       CRPIX1P =                    1 / reference CCD column                           CRVAL1P =                 1029 / value at reference CCD column                  CDELT1P =                  1.0 / physical WCS axis 1 step                       CTYPE2P = 'RAWY    '           / physical WCS axis 2 type CCD row               CUNIT2P = 'PIXEL   '           / physical WCS axis 2 units                      CRPIX2P =                    1 / reference CCD row                              CRVAL2P =                  233 / value at reference CCD row                     CDELT2P =                  1.0 / physical WCS axis 2 step                       NPIXSAP =                    5 / Number of pixels in optimal aperture           NPIXMISS=                    0 / Number of op. aperture pixels not collected    CHECKSUM= 'GMaHGKYHGKaHGKWH'   / HDU checksum updated 2015-10-06T22:36:32Z      END                                                                                                         