 / right ascension coordinate type                CTYPE2  = 'DEC--TAN'           / declination coordinate type                    CRPIX1  =   3.8679163573225424 / [pixel] reference pixel along image axis 1     CRPIX2  =    2.857606947532446 / [pixel] reference pixel along image axis 2     CRVAL1  =          281.6691705 / [deg] right ascension at reference pixel       CRVAL2  =             42.03864 / [deg] declination at reference pixel           CUNIT1  = 'deg     '           / physical unit in column dimension              CUNIT2  = 'deg     '           / physical unit in row dimension                 CDELT1  =   -0.001099070102353 / [deg] pixel scale in RA dimension              CDELT2  =    0.001099070102353 / [deg] pixel scale in Dec dimension             PC1_1   =   0.6302391030108521 / linear transformation element cos(th)          PC1_2   =  -0.7714302309369517 / linear transformation element -sin(th)         PC2_1   =   0.7773443894243027 / linear transformation element sin(th)          PC2_2   =   0.6352081872361595 / linear transformation element cos(th)          WCSNAMEP= 'PHYSICAL'           / name of world coordinate system alternate P    WCSAXESP=                    2 / number of WCS physical axes                    CTYPE1P = 'RAWX    '           / physical WCS axis 1 type CCD col               CUNIT1P = 'PIXEL   '           / physical WCS axis 1 unit                       CRPIX1P =                    1 / reference CCD column                           CRVAL1P =                  225 / value at reference CCD column                  CDELT1P =                  1.0 / physical WCS axis 1 step                       CTYPE2P = 'RAWY    '           / physical WCS axis 2 type CCD row               CUNIT2P = 'PIXEL   '           / physical WCS axis 2 units                      CRPIX2P =                    1 / reference CCD row                              CRVAL2P =                  153 / value at reference CCD row                     CDELT2P =                  1.0