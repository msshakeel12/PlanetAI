  =                    1 / extension version number (not format version)  TELESCOP= 'Kepler  '           / telescope                                      INSTRUME= 'Kepler Photometer'  / detector type                                  OBJECT  = 'KIC 8018547'        / string version of target id                    KEPLERID=              8018547 / unique Kepler target identifier                RADESYS = 'ICRS    '           / reference frame of celestial coordinates       RA_OBJ  =           287.852390 / [deg] right ascension                          DEC_OBJ =            43.897990 / [deg] declination                              EQUINOX =               2000.0 / equinox of celestial coordinate system         WCSAXES =                    2 / number of WCS axes                             CTYPE1  = 'RA---TAN'           / right ascension coordinate type                CTYPE2  = 'DEC--TAN'           / declination coordinate type                    CRPIX1  =   4.0892180591101805 / [pixel] reference pixel along image axis 1     CRPIX2  =    3.086937937491598 / [pixel] reference pixel along image axis 2     CRVAL1  =          287.8523895 / [deg] right ascension at reference pixel       CRVAL2  =             43.89799 / [deg] declination at reference pixel           CUNIT1  = 'deg     '           / physical unit in column dimension              CUNIT2  = 'deg     '           / physical unit in row dimension                 CDELT1  =   -0.001106001197791 / [deg] pixel scale in RA dimension              CDELT2  =    0.001106001197791 / [deg] pixel scale in Dec dimension             PC1_1   =  -0.5745154986434491 / linear transformation element cos(th)          PC1_2   =   0.8206184156735403 / linear transformation element -sin(th)         PC2_1   =  -0.8180511078825735 / linear transformation element sin(th)          PC2_2   =  -0.5721206767885794 / linear transformation element cos(th)          WCSNAMEP= 'PHYSICAL'           / name of world coordinate system alternate P    WCSAXE