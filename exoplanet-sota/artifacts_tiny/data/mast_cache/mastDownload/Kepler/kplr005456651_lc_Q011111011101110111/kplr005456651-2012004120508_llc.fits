 telescope                                      INSTRUME= 'Kepler Photometer'  / detector type                                  OBJECT  = 'KIC 5456651'        / string version of target id                    KEPLERID=              5456651 / unique Kepler target identifier                RADESYS = 'ICRS    '           / reference frame of celestial coordinates       RA_OBJ  =           294.202140 / [deg] right ascension                          DEC_OBJ =            40.663410 / [deg] declination                              EQUINOX =               2000.0 / equinox of celestial coordinate system         WCSAXES =                    2 / number of WCS axes                             CTYPE1  = 'RA---TAN'           / right ascension coordinate type                CTYPE2  = 'DEC--TAN'           / declination coordinate type                    CRPIX1  =   3.8569129076694253 / [pixel] reference pixel along image axis 1     CRPIX2  =    2.585311528723281 / [pixel] reference pixel along image axis 2     CRVAL1  =            294.20214 / [deg] right ascension at reference pixel       CRVAL2  =             40.66341 / [deg] declination at reference pixel           CUNIT1  = 'deg     '           / physical unit in column dimension              CUNIT2  = 'deg     '           / physical unit in row dimension                 CDELT1  =   -0.001106354796341 / [deg] pixel scale in RA dimension              CDELT2  =    0.001106354796341 / [deg] pixel scale in Dec dimension             PC1_1   =   0.8626045194294563 / linear transformation element cos(th)          PC1_2   =  -0.5100772626018243 / linear transformation element -sin(th)         PC2_1   =  -0.5082300039599263 / linear transformation element sin(th)          PC2_2   =  -0.8587520864114669 / linear transformation element cos(th)          WCSNAMEP= 'PHYSICAL'           / name of world coordinate system alternate P    WCSAXESP=                    2 / number of WCS physical axes                    CTYPE1P = 'RAWX    '           /